{
  "name": "loretto-church",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "worker:dev": "wrangler dev worker/src/index.js --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy worker/src/index.js --config worker/wrangler.toml",
    "db:migrate:local": "wrangler d1 execute loretto-db --local --file=worker/migrations/0001_initial_schema.sql --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 execute loretto-db --remote --file=worker/migrations/0001_initial_schema.sql --config worker/wrangler.toml"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
